@prefix ex: <https://github.com/dbotteld/HearingThreshold/blob/main/> .
@prefix gbif: <https://www.gbif.org/species/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:commonName a owl:AnnotationProperty ;
    rdfs:label "common name"@en ;
    rdfs:domain ex:Animal ;
    rdfs:range xsd:string .

ex:frequency a owl:DatatypeProperty ;
    rdfs:label "frequency [Hz]"@en ;
    rdfs:domain ex:HearingThresholdMeasurement ;
    rdfs:range xsd:double .

ex:hasHearingThresholdCampaign a owl:AnnotationProperty ;
    rdfs:label "has HT Measurement Campaign"@en ;
    rdfs:domain ex:Animal ;
    rdfs:range ex:HearingThresholdMeasurementCampaign .

ex:hasMeasurement a owl:ObjectProperty ;
    rdfs:label "contains frequency-level pair"@en ;
    rdfs:domain ex:HearingThresholdMeasurementCampaign ;
    rdfs:range ex:HearingThresholdMeasurement .

ex:measuredOnTaxon a owl:ObjectProperty ;
    rdfs:label "is measured on Taxon"@en ;
    rdfs:domain ex:HearingThresholdMeasurementCampaign ;
    rdfs:range ex:Animal .

ex:partOf a owl:ObjectProperty ;
    rdfs:label "is part of"@en ;
    rdfs:domain ex:HearingThresholdMeasurement ;
    rdfs:range ex:HearingThresholdMeasurementCampaign .

ex:pubAuthor a owl:DatatypeProperty ;
    rdfs:label "publication author"@en ;
    rdfs:domain ex:HearingThresholdMeasurementCampaign ;
    rdfs:range xsd:string .

ex:pubDOI a owl:DatatypeProperty ;
    rdfs:label "publication DOI"@en ;
    rdfs:domain ex:HearingThresholdMeasurementCampaign ;
    rdfs:range xsd:string .

ex:pubID a owl:DatatypeProperty ;
    rdfs:label "publication ID"@en ;
    rdfs:domain ex:HearingThresholdMeasurementCampaign ;
    rdfs:range xsd:string .

ex:pubTitle a owl:DatatypeProperty ;
    rdfs:label "publication title"@en ;
    rdfs:domain ex:HearingThresholdMeasurementCampaign ;
    rdfs:range xsd:string .

ex:pubYear a owl:DatatypeProperty ;
    rdfs:label "publication year"@en ;
    rdfs:domain ex:HearingThresholdMeasurementCampaign ;
    rdfs:range xsd:integer .

ex:rank a owl:AnnotationProperty ;
    rdfs:label "taxonomic rank"@en ;
    rdfs:domain ex:Animal ;
    rdfs:range xsd:string .

ex:thresholdLevel a owl:DatatypeProperty ;
    rdfs:label "threshold [dB]"@en ;
    rdfs:domain ex:HearingThresholdMeasurement ;
    rdfs:range xsd:double .

ex:usesMeasurementMethod a owl:ObjectProperty ;
    rdfs:label "uses Measurement Method"@en ;
    rdfs:domain ex:HearingThresholdMeasurementCampaign ;
    rdfs:range ex:MeasurementMethod .

